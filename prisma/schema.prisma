generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                String     @id
  name              String
  email             String
  emailVerified     Boolean
  image             String?
  createdAt         DateTime
  updatedAt         DateTime
  role              Role       @default(USER)
  sessions          Session[]
  accounts          Account[]
  goals             Goal[]
  cheers            Cheer[]
  sentReminders     Reminder[] @relation("ReminderSender")
  receivedReminders Reminder[] @relation("ReminderRecipient")
  sentFlames        Flame[]    @relation("FlameSender")
  receivedFlames    Flame[]    @relation("FlameRecipient")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum Role {
  USER
  ADMIN
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  targetDate  DateTime
  status      String     @default("active") // "active", "shipped", "failed"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cheers      Cheer[]
  reminders   Reminder[]
  flames      Flame[]

  @@map("goal")
}

model Cheer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, goalId])
  @@map("cheer")
}

model Reminder {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("ReminderSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ReminderRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  message     String?
  createdAt   DateTime @default(now())

  @@map("reminder")
}

model Flame {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("FlameSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("FlameRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  message     String?
  createdAt   DateTime @default(now())

  @@map("flame")
}
